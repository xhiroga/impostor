IMPOSTOR_OUTPUT_DIR=output

CLOUDFLARE_R2_BUCKET=impostor-output
CLOUDFLARE_R2_S3_API=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

## Model checkpoints
IMPOSTOR_DIT_PATH=/workspace/models/diffusion_models/FramePackI2V_HY
